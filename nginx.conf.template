server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # API requests must use the separately hosted backend.
    location /api {
        return 404;
    }

    # Support direct links and refreshes on client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
